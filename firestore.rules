rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User chỉ đọc/ghi profile của chính mình (doc mục 10)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Experiences: ai đăng nhập cũng đọc được; chỉ creator sửa/xóa
    match /experiences/{expId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.budget is number
        && request.resource.data.budget > 0;
      // Creator sửa/xóa tự do; user thường chỉ được cập nhật aggregate rating khi viết review
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount'])
      );
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    // Dữ liệu cá nhân: bookmarks / completed / achievements
    match /bookmarks/{userId}/items/{expId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /completed/{userId}/items/{expId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /achievements/{userId}/badges/{badgeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
